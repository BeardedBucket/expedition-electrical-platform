{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://expedition-electrical-platform.dev/schemas/production-ingestion.schema.json",
  "title": "Production ingestion artifacts",
  "oneOf": [
    { "$ref": "#/$defs/productIntake" },
    { "$ref": "#/$defs/sourceCapture" },
    { "$ref": "#/$defs/sourceRevision" },
    { "$ref": "#/$defs/documentExtraction" },
    { "$ref": "#/$defs/qualifiedFact" },
    { "$ref": "#/$defs/semanticProposal" },
    { "$ref": "#/$defs/reviewPackage" },
    { "$ref": "#/$defs/approval" },
    { "$ref": "#/$defs/productRun" },
    { "$ref": "#/$defs/ingestionJob" }
  ],
  "$defs": {
    "version": { "const": "1.0" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifactRef": {
      "type": "object",
      "required": ["kind", "reference_schema_version", "digest", "digest_algorithm"],
      "properties": {
        "kind": {
          "enum": [
            "product_intake",
            "source_capture",
            "source_revision",
            "document_extraction",
            "qualified_fact",
            "semantic_proposal",
            "product_candidate",
            "product_source",
            "product_fact",
            "review_package",
            "approval",
            "ingestion_job",
            "product_run"
          ]
        },
        "reference_schema_version": { "$ref": "#/$defs/version" },
        "referenced_artifact_schema_version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "digest_algorithm": { "const": "sha256" },
        "reference": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "productIntakeRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "product_intake" } } }
      ]
    },
    "candidateRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "product_candidate" } } }
      ]
    },
    "sourceRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "enum": ["source_capture", "source_revision", "product_source"] }
          }
        }
      ]
    },
    "sourceCaptureRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "source_capture" } } }
      ]
    },
    "factRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "enum": ["qualified_fact", "product_fact"] } } }
      ]
    },
    "proposalRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "semantic_proposal" } } }
      ]
    },
    "reviewPackageRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        { "properties": { "kind": { "const": "review_package" } } }
      ]
    },
    "sourceRevisionRef": {
      "allOf": [
        { "$ref": "#/$defs/artifactRef" },
        {
          "properties": {
            "kind": { "enum": ["source_capture", "source_revision", "product_source"] }
          }
        }
      ]
    },
    "productIntake": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "manufacturer",
        "product_model",
        "manufacturer_part_number",
        "official_product_uri"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "product_intake" },
        "id": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "product_model": { "type": "string", "minLength": 1 },
        "manufacturer_part_number": { "type": "string", "minLength": 1 },
        "official_product_uri": { "type": "string", "format": "uri" },
        "submitted_at": { "type": "string", "format": "date-time" },
        "additional_official_source_uris": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        }
      },
      "additionalProperties": false
    },
    "sourceCapture": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "requested_uri",
        "retrieved_at",
        "disposition",
        "retention_status"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "source_capture" },
        "id": { "type": "string", "minLength": 1 },
        "requested_uri": { "type": "string", "format": "uri" },
        "final_uri": { "type": "string", "format": "uri" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "media_type": { "type": "string", "minLength": 1 },
        "response_status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "disposition": { "enum": ["authoritative", "non_authoritative", "failed", "empty"] },
        "content_digest": { "$ref": "#/$defs/digest" },
        "digest_algorithm": { "const": "sha256" },
        "snapshot": { "$ref": "#/$defs/artifactRef" },
        "retention_status": { "enum": ["retained", "not_retained", "not_permitted", "unknown"] },
        "source_provenance": { "type": "object" },
        "document_revision": { "type": "string" },
        "publication_date": { "type": "string" },
        "etag": { "type": "string" },
        "last_modified": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "retention_status": { "const": "retained" } } },
          "then": { "required": ["snapshot", "content_digest", "digest_algorithm"] }
        },
        {
          "if": {
            "properties": {
              "retention_status": {
                "enum": ["not_retained", "not_permitted", "unknown"]
              }
            }
          },
          "then": { "not": { "required": ["snapshot"] } }
        },
        {
          "if": {
            "properties": {
              "disposition": { "enum": ["authoritative", "non_authoritative"] }
            }
          },
          "then": { "required": ["content_digest", "digest_algorithm"] }
        }
      ],
      "additionalProperties": false
    },
    "sourceRevision": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "capture",
        "content_digest",
        "digest_algorithm"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "source_revision" },
        "id": { "type": "string", "minLength": 1 },
        "capture": { "$ref": "#/$defs/sourceCaptureRef" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "digest_algorithm": { "const": "sha256" },
        "relations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["relation", "artifact"],
                "properties": {
                  "relation": { "enum": ["predecessor", "supersedes"] },
                  "artifact": {
                    "allOf": [
                      { "$ref": "#/$defs/artifactRef" },
                      { "properties": { "kind": { "const": "source_revision" } } }
                    ]
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["relation", "artifact"],
                "properties": {
                  "relation": { "enum": ["same_content", "related"] },
                  "artifact": { "$ref": "#/$defs/sourceRevisionRef" }
                },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "documentExtraction": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "source_capture",
        "extractor",
        "extractor_version",
        "blocks"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "document_extraction" },
        "id": { "type": "string", "minLength": 1 },
        "source_capture": { "$ref": "#/$defs/sourceRef" },
        "extractor": { "type": "string", "minLength": 1 },
        "extractor_version": { "type": "string", "minLength": 1 },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "locator"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["text", "table", "structured", "unsupported", "unresolved"] },
              "locator": { "type": "string" },
              "content": { "type": "string" },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["label", "value"],
                  "properties": {
                    "label": { "type": "string" },
                    "value": { "type": "string" }
                  },
                  "additionalProperties": false
                }
              },
              "reason": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "exact_sku",
            "model",
            "family",
            "variant",
            "hardware_revision",
            "unresolved",
            "not_applicable"
          ]
        },
        "value": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    },
    "qualifiedFact": {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "id", "source_capture", "metadata"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "qualified_fact" },
        "id": { "type": "string", "minLength": 1 },
        "source_capture": { "$ref": "#/$defs/sourceRef" },
        "document_extraction": { "$ref": "#/$defs/artifactRef" },
        "metadata": {
          "type": "object",
          "required": ["source_wording", "raw_value", "applicability"],
          "properties": {
            "source_wording": { "type": "string", "minLength": 1 },
            "raw_value": {},
            "source_unit": { "type": "string" },
            "conditions": { "type": "array", "items": { "type": "string" } },
            "duration": { "type": "string" },
            "temperature_context": { "type": "string" },
            "applicability": { "$ref": "#/$defs/applicability" },
            "revision_context": { "type": "string" },
            "derived_value": {},
            "derivation": { "type": "string" },
            "alternative_interpretations": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "semanticProposal": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "target",
        "evidence_refs",
        "disposition",
        "provenance",
        "input_artifact_digests"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "semantic_proposal" },
        "id": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "proposed_value": {},
        "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "fact_refs": { "type": "array", "items": { "$ref": "#/$defs/factRef" } },
        "disposition": {
          "enum": [
            "mapped",
            "evidence_only",
            "ambiguous",
            "unresolved",
            "conflicting",
            "unsupported",
            "rejected"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rationale"],
            "properties": {
              "value": {},
              "rationale": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "provenance": {
          "type": "object",
          "required": ["method"],
          "properties": {
            "method": { "enum": ["rule", "machine", "human", "other"] },
            "rule_version": { "type": "string" },
            "provider": { "type": "string" },
            "provider_version": { "type": "string" },
            "rationale": { "type": "string" }
          },
          "additionalProperties": false
        },
        "input_artifact_digests": { "type": "array", "items": { "$ref": "#/$defs/digest" } }
      },
      "additionalProperties": false
    },
    "reviewPackage": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "intake",
        "source_refs",
        "fact_refs",
        "proposal_refs",
        "semantic_snapshot"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "review_package" },
        "id": { "type": "string", "minLength": 1 },
        "intake": { "$ref": "#/$defs/productIntakeRef" },
        "candidate": { "$ref": "#/$defs/candidateRef" },
        "source_refs": { "type": "array", "items": { "$ref": "#/$defs/sourceRef" } },
        "fact_refs": { "type": "array", "items": { "$ref": "#/$defs/factRef" } },
        "applicability": { "type": "array", "items": { "$ref": "#/$defs/applicability" } },
        "proposal_refs": { "type": "array", "items": { "$ref": "#/$defs/proposalRef" } },
        "topology_proposal_refs": { "type": "array", "items": { "$ref": "#/$defs/proposalRef" } },
        "unresolved_items": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "semantic_snapshot": { "$ref": "#/$defs/digest" },
        "prior_reviewed_revision": { "$ref": "#/$defs/artifactRef" },
        "semantic_diff": {}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "review_package",
        "review_package_snapshot",
        "semantic_snapshot",
        "reviewer_id",
        "decision",
        "reviewed_at"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "approval" },
        "id": { "type": "string" },
        "review_package": { "$ref": "#/$defs/reviewPackageRef" },
        "review_package_snapshot": { "$ref": "#/$defs/digest" },
        "semantic_snapshot": { "$ref": "#/$defs/digest" },
        "reviewer_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["approved", "rejected", "deferred"] },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "reviewed_decisions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "productRun": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_kind",
        "id",
        "intake",
        "state",
        "attempt",
        "artifact_refs"
      ],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "product_run" },
        "id": { "type": "string" },
        "intake": { "$ref": "#/$defs/artifactRef" },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "promotable",
            "unresolved_awaiting_human_review",
            "insufficient_evidence",
            "conflicting_evidence",
            "existing_product_update",
            "blocked",
            "failed"
          ]
        },
        "current_stage": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 0 },
        "retryable": { "type": "boolean" },
        "artifact_refs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
        "input_hash": { "$ref": "#/$defs/digest" },
        "output_hash": { "$ref": "#/$defs/digest" },
        "failure_code": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ingestionJob": {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "id", "created_at", "state", "product_runs"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/version" },
        "artifact_kind": { "const": "ingestion_job" },
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "state": { "enum": ["queued", "running", "completed", "failed", "partially_completed"] },
        "product_runs": { "type": "array", "items": { "$ref": "#/$defs/artifactRef" } },
        "manifest_ref": { "$ref": "#/$defs/artifactRef" }
      },
      "additionalProperties": false
    }
  }
}
