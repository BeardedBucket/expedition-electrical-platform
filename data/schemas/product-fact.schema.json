{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:product-fact",
  "title": "Extracted product fact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "source_id",
    "field",
    "raw_label",
    "raw_value",
    "extraction_method",
    "fact_state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "field": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)*$"
    },
    "raw_label": {
      "type": "string",
      "minLength": 1
    },
    "raw_value": {},
    "raw_unit": {
      "type": "string",
      "minLength": 1
    },
    "normalized_value": {},
    "normalized_unit": {
      "type": "string",
      "minLength": 1
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        },
        "paragraph": {
          "type": "string",
          "minLength": 1
        },
        "fragment": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1
    },
    "extraction_method": {
      "enum": ["structured", "table", "text", "manual", "ai_assisted", "other"]
    },
    "transformation_notes": {
      "type": "string"
    },
    "review_required": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "fact_state": {
      "enum": ["verified", "provisional", "unresolved", "conflicting"]
    },
    "topology_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {
          "enum": [
            "capability",
            "port",
            "power_path",
            "connection_point",
            "conductive_relationship",
            "switching_configuration",
            "protection_instance",
            "measurement_instance",
            "interaction_endpoint",
            "physical_connector",
            "physical_connector_association"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\d+$)(?!.*\\[[0-9]+\\])[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "field"],
      "properties": {
        "kind": {
          "const": "conductive_relationship"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qualified_value": {
      "$ref": "#/$defs/canonicalQualifiedValue"
    }
  },
  "$defs": {
    "canonicalQualifiedValue": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "target", "value", "qualifiers"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]+$"
            },
            "target": {
              "const": "electrical.input_voltage_range_v"
            },
            "value": {
              "type": "object",
              "required": ["min", "max"],
              "properties": {
                "min": {
                  "type": "number",
                  "minimum": 0
                },
                "max": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "qualifiers": {
              "type": "object",
              "required": ["electrical_domain"],
              "properties": {
                "electrical_domain": {
                  "enum": ["ac", "dc"]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "target", "value", "qualifiers"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]+$"
            },
            "target": {
              "const": "dimensions_mm"
            },
            "value": {
              "type": "object",
              "required": ["x", "y", "z"],
              "properties": {
                "x": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "y": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "z": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "qualifiers": {
              "type": "object",
              "required": ["physical_scope"],
              "properties": {
                "physical_scope": {
                  "type": "object",
                  "required": ["kind", "exclusions"],
                  "properties": {
                    "kind": {
                      "const": "physical_body"
                    },
                    "exclusions": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "enum": ["connectors", "mounting_accessories"]
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
