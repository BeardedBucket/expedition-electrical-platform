{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition:installed-operating-scenario:v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "installed-operating-scenario.v1"
    },
    "uses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "instance_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "battery": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "operation": {
                "enum": ["charge", "discharge"]
              },
              "temperature": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "value_c": {
                    "type": "number"
                  },
                  "measurement_point": {
                    "enum": ["battery_cell", "ambient"]
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                },
                "required": ["value_c", "measurement_point", "rationale"]
              },
              "heater_state": {
                "enum": ["after_heating", "not_after_heating"]
              },
              "series_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "parallel_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "matched_bank": {
                "type": "boolean"
              },
              "requires_bms_recovery": {
                "type": "boolean"
              }
            },
            "required": ["operation"]
          },
          "monitoring": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "quantity": {
                "enum": ["dc_current", "dc_voltage"]
              },
              "max_error_percent": {
                "type": "number",
                "minimum": 0
              },
              "basis": {
                "enum": ["reading", "full_scale"]
              },
              "measured_value": {
                "type": "number"
              },
              "temperature_c": {
                "type": "number"
              },
              "measurement_path": {
                "const": "external_shunt"
              },
              "current_path_a": {
                "type": "number"
              },
              "shunt_current_a": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shunt_drop_mv": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "calibration_evidence_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": ["quantity", "max_error_percent", "basis"]
          }
        },
        "required": ["instance_id"],
        "anyOf": [
          {
            "required": ["battery"]
          },
          {
            "required": ["monitoring"]
          }
        ]
      }
    }
  },
  "required": ["version", "uses"]
}
