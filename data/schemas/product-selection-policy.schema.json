{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:product-selection-policy",
  "type": "object",
  "required": [
    "id",
    "version",
    "kind",
    "status",
    "description",
    "source_refs",
    "rationale",
    "bounds"
  ],
  "properties": {
    "id": {
      "const": "product-selection"
    },
    "version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "constraint"
    },
    "status": {
      "enum": ["draft", "reviewed", "approved", "deprecated"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "title", "path"],
        "properties": {
          "type": {
            "const": "project-rationale"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "bounds": {
      "type": "object",
      "required": [
        "max_products",
        "max_bindings_per_candidate",
        "max_total_bindings",
        "max_assembly_units"
      ],
      "properties": {
        "max_products": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_bindings_per_candidate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_total_bindings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max_assembly_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
