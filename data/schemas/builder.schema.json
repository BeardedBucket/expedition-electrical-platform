{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Builder Profile",
  "type": "object",
  "required": ["builder_id", "display_name"],
  "properties": {
    "builder_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "builderId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "display_name": { "type": "string" },
    "displayName": { "type": "string" },
    "website": { "type": ["string", "null"], "format": "uri" },
    "inquiry_url": { "type": ["string", "null"], "format": "uri" },
    "inquiryUrl": { "type": ["string", "null"], "format": "uri" },
    "regions": { "type": "array", "items": { "type": "string" } },
    "services": { "type": "array", "items": { "type": "string" } },
    "inventory_mode": { "enum": ["unrestricted", "allowlist", "denylist"] },
    "inventoryMode": { "enum": ["unrestricted", "allowlist", "denylist"] },
    "inventory_component_ids": { "type": "array", "items": { "type": "string" } },
    "inventoryComponentIds": { "type": "array", "items": { "type": "string" } },
    "preferred_component_ids": { "type": "array", "items": { "type": "string" } },
    "preferredComponentIds": { "type": "array", "items": { "type": "string" } },
    "preferred_manufacturers": { "type": "array", "items": { "type": "string" } },
    "preferredManufacturers": { "type": "array", "items": { "type": "string" } },
    "supported_system_voltages_v": { "type": "array", "items": { "type": "number" } },
    "supportedSystemVoltagesV": { "type": "array", "items": { "type": "number" } },
    "catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["component_id", "availability", "preference"],
        "properties": {
          "component_id": { "type": "string", "minLength": 1 },
          "componentId": { "type": "string", "minLength": 1 },
          "availability": {
            "enum": ["stocked", "special_order", "unavailable", "discontinued", "unknown"]
          },
          "availabilityStatus": {
            "enum": ["stocked", "special_order", "unavailable", "discontinued", "unknown"]
          },
          "preference": { "enum": ["preferred", "standard", "discouraged"] },
          "preferenceLevel": { "enum": ["preferred", "standard", "discouraged"] },
          "builder_price": { "type": ["number", "null"], "minimum": 0 },
          "builderPrice": { "type": ["number", "null"], "minimum": 0 },
          "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "currencyCode": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
          "lead_time_days": { "type": ["integer", "null"], "minimum": 0 },
          "leadTimeDays": { "type": ["integer", "null"], "minimum": 0 },
          "lead_time_text": { "type": ["string", "null"] },
          "leadTimeText": { "type": ["string", "null"] },
          "sku": { "type": ["string", "null"] },
          "last_checked_at": { "type": ["string", "null"] },
          "lastCheckedAt": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "tracking": {
      "type": "object",
      "properties": {
        "source_key": { "type": "string" },
        "sourceKey": { "type": "string" },
        "campaign_default": { "type": ["string", "null"] },
        "campaignDefault": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
