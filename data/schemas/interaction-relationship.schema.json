{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:interaction-relationship",
  "title": "Manufacturer-asserted interaction relationship",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "relationship_kind",
    "participants",
    "scope",
    "evidence",
    "state"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "relationship_kind": {
      "enum": [
        "manufacturer_interoperability",
        "required_intermediate",
        "information_sharing",
        "information_consumption",
        "control_interaction"
      ]
    },
    "assertion": { "enum": ["positive", "negative"] },
    "participants": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/participant" }
    },
    "normalized_participants": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/normalizedParticipant" }
    },
    "required_intermediates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "enum": [
        "exact_product",
        "model",
        "product_family",
        "manufacturer_ecosystem",
        "accessory_class",
        "unknown"
      ]
    },
    "information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["direction", "participant_ref", "term"],
        "properties": {
          "direction": { "enum": ["exposes", "consumes"] },
          "participant_ref": { "type": "string", "minLength": 1 },
          "term": { "type": "string", "minLength": 1 },
          "raw_wording": { "type": "string", "minLength": 1 }
        }
      }
    },
    "normalized_information": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "direction", "participant_id", "term"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["exposes", "consumes"] },
          "participant_id": { "type": "string", "minLength": 1 },
          "term": { "type": "string", "minLength": 1 },
          "raw_wording": { "type": "string", "minLength": 1 }
        }
      }
    },
    "information_distributions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "source_claim_id",
              "consumer_claim_ids",
              "source_ids",
              "fact_ids"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "explicit_consumers" },
              "source_claim_id": { "type": "string", "minLength": 1 },
              "consumer_claim_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "fact_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "raw_wording": { "type": "string", "minLength": 1 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "source_claim_id", "source_ids", "fact_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "const": "shared_publication" },
              "source_claim_id": { "type": "string", "minLength": 1 },
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "fact_ids": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "raw_wording": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "control_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "controller_participant_id",
          "target_participant_id",
          "action",
          "source_ids",
          "fact_ids"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "controller_participant_id": { "type": "string", "minLength": 1 },
          "target_participant_id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "raw_wording": { "type": "string", "minLength": 1 }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": {
            "enum": [
              "accessory_required",
              "brand_dependent",
              "firmware",
              "hardware_revision",
              "connection",
              "configuration",
              "other"
            ]
          },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "applicability": {
      "type": "array",
      "items": { "$ref": "#/$defs/applicability" }
    },
    "prerequisites": {
      "type": "array",
      "items": { "$ref": "#/$defs/prerequisite" }
    },
    "evidence_scopes": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceScope" }
    },
    "notes": { "type": "string" },
    "promotion_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id",
          "candidate_id",
          "relationship_id",
          "reviewer_id",
          "reviewed_at",
          "expected_snapshot",
          "canonical_snapshot",
          "decision",
          "source_ids",
          "fact_ids"
        ],
        "properties": {
          "review_id": { "type": "string", "minLength": 1 },
          "candidate_id": { "type": "string", "minLength": 1 },
          "relationship_id": { "type": "string", "minLength": 1 },
          "reviewer_id": { "type": "string", "minLength": 1 },
          "reviewed_at": { "type": "string", "minLength": 1 },
          "expected_snapshot": { "type": "string", "minLength": 1 },
          "canonical_snapshot": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["approved", "rejected"] },
          "source_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "fact_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "fact_ids"],
      "properties": {
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "applicability": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceApplicability" }
        }
      }
    },
    "state": {
      "enum": ["verified", "provisional", "unresolved", "conflicting"]
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "role"],
      "properties": {
        "ref": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$" },
        "kind": {
          "enum": [
            "interaction_endpoint",
            "exact_product",
            "product_model",
            "product_family",
            "manufacturer_ecosystem",
            "accessory_class",
            "unresolved_external"
          ]
        },
        "role": { "type": "string", "minLength": 1 },
        "endpoint_id": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "normalizedParticipant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reference", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reference": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "component_id"],
              "properties": {
                "kind": { "const": "component" },
                "component_id": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "component_id", "endpoint_id"],
              "properties": {
                "kind": { "const": "interaction_endpoint" },
                "component_id": { "type": "string", "minLength": 1 },
                "endpoint_id": { "type": "string", "minLength": 1 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "reference"],
              "properties": {
                "kind": { "const": "unresolved_external" },
                "reference": { "type": "string", "minLength": 1 }
              }
            }
          ]
        },
        "role": { "type": "string", "minLength": 1 },
        "display_name": { "type": "string", "minLength": 1 }
      }
    },
    "applicability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "target_participant_id",
            "kind",
            "operator",
            "value",
            "source_ids",
            "fact_ids"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "target_participant_id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["firmware", "hardware_revision"] },
            "operator": { "const": "equals" },
            "value": { "type": "string", "minLength": 1 },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "raw_wording": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "raw_value", "source_ids", "fact_ids"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "target_participant_id": { "type": "string", "minLength": 1 },
            "kind": { "const": "other" },
            "raw_value": { "type": "string", "minLength": 1 },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "prerequisite": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "participant_id", "source_ids", "fact_ids"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "intermediate" },
            "participant_id": { "type": "string", "minLength": 1 },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "raw_wording": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "target", "key", "operator", "source_ids", "fact_ids"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "configuration" },
            "target": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "participant_id"],
                  "properties": {
                    "kind": { "const": "participant" },
                    "participant_id": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind"],
                  "properties": { "kind": { "const": "relationship" } }
                }
              ]
            },
            "key": { "type": "string", "minLength": 1 },
            "operator": { "enum": ["equals", "present"] },
            "value": { "type": ["string", "number", "boolean", "null"] },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "raw_wording": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "participant_ids", "topology", "source_ids", "fact_ids"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "connection" },
            "participant_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string", "minLength": 1 }
            },
            "topology": { "enum": ["direct", "shared_network", "direct_or_shared_network"] },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "raw_wording": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "raw_value", "source_ids", "fact_ids"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "const": "other" },
            "raw_value": { "type": "string", "minLength": 1 },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "fact_ids": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "evidenceScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source_reference", "source_ids", "fact_ids", "resolution"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "exact_product",
            "model",
            "family",
            "ecosystem",
            "product_series",
            "accessory_scope",
            "unresolved",
            "other"
          ]
        },
        "source_reference": { "type": "string", "minLength": 1 },
        "source_wording": { "type": "string", "minLength": 1 },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fact_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "resolution": { "enum": ["resolved", "partially_resolved", "unresolved"] },
        "resolved_component_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "evidenceApplicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "exact_product",
            "product_model",
            "product_family",
            "manufacturer_ecosystem",
            "accessory_class",
            "unresolved",
            "other"
          ]
        },
        "ref": { "type": "string", "minLength": 1 },
        "manufacturer": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "accessory": { "type": "string", "minLength": 1 }
      },
      "required": ["scope"]
    }
  }
}
