{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition:installed-source-draft-scenario:v1",
  "type": "object",
  "properties": {
    "version": { "const": "installed-source-draft-scenario.v1" },
    "uses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance_id": { "type": "string", "minLength": 1 },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "quantity": { "type": "string", "minLength": 1 },
                "mode": { "type": "string", "minLength": 1 },
                "direction": { "enum": ["input", "output", "bidirectional", "none", "unknown"] },
                "electrical_domain": { "enum": ["dc", "ac", "none", "unknown"] },
                "unit": { "type": "string", "minLength": 1 },
                "value": { "anyOf": [{ "type": "number" }, { "type": "string", "minLength": 1 }] },
                "predicate": { "enum": ["within_range", "at_most", "at_least", "equals"] },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": { "type": "string", "minLength": 1 },
                      "value": {
                        "anyOf": [
                          { "type": "number" },
                          { "type": "string", "minLength": 1 },
                          { "type": "boolean" }
                        ]
                      },
                      "unit": { "type": "string", "minLength": 1 }
                    },
                    "required": ["key", "value", "unit"],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "quantity",
                "mode",
                "direction",
                "electrical_domain",
                "unit",
                "value",
                "predicate",
                "conditions"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": ["instance_id", "requirements"],
        "additionalProperties": false
      }
    },
    "pv_arrays": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "controller_instance_id": { "type": "string", "minLength": 1 },
          "strings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "series_count": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "module_instance_ids": {
                  "anyOf": [
                    { "type": "null" },
                    { "type": "array", "items": { "type": "string", "minLength": 1 } }
                  ]
                }
              },
              "required": ["series_count", "module_instance_ids"],
              "additionalProperties": false
            }
          },
          "module_temperature_c": { "type": ["number", "null"] },
          "irradiance_w_m2": { "type": ["number", "null"] },
          "spectrum": { "type": ["string", "null"] },
          "tracker_id": { "type": ["string", "null"] },
          "battery_voltage_v": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "controller_state": { "enum": ["startup", "running", null] }
        },
        "required": [
          "controller_instance_id",
          "strings",
          "module_temperature_c",
          "irradiance_w_m2",
          "spectrum",
          "tracker_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "uses"],
  "additionalProperties": false
}
