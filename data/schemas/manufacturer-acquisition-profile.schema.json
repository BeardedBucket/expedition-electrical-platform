{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:manufacturer-acquisition-profile",
  "title": "Manufacturer acquisition profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile_status",
    "manufacturer",
    "publisher",
    "official_domains",
    "strategies",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "profile_status": { "enum": ["proposed", "reviewed"] },
    "manufacturer": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "official_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "path_prefix", "embedded_json", "document_link_discovery"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "status": { "enum": ["proposed", "reviewed"] },
          "reference_uri": { "type": "string", "format": "uri", "minLength": 1 },
          "path_prefix": { "type": "string", "pattern": "^/" },
          "embedded_json": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "representation",
              "script",
              "json_path",
              "record_collection_path",
              "identity_property"
            ],
            "properties": {
              "representation": { "enum": ["embedded_json", "application_state"] },
              "script": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "media_type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "media_type": { "const": "application/json" }
                }
              },
              "json_path": { "type": "string", "minLength": 1 },
              "record_collection_path": { "type": "string", "minLength": 1 },
              "identity_property": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$" }
            }
          },
          "document_link_discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": ["link_attribute", "allowed_extensions", "path_prefix"],
            "properties": {
              "link_attribute": { "const": "href" },
              "allowed_extensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
              },
              "path_prefix": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact", "observed_source_content_hash"],
      "properties": {
        "source_artifact": { "type": "string", "minLength": 1 },
        "observed_source_content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
