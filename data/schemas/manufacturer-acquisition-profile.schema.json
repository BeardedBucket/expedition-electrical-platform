{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:manufacturer-acquisition-profile",
  "title": "Manufacturer acquisition profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "profile_status",
    "manufacturer",
    "publisher",
    "official_domains",
    "strategies",
    "provenance"
  ],
  "properties": {
    "schema_version": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "profile_status": { "enum": ["proposed", "reviewed"] },
    "manufacturer": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "official_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "approved_subdomains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "allowed_document_domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "allowed_document_subdomains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "path_prefix", "embedded_json", "document_link_discovery"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "status": { "enum": ["proposed", "reviewed"] },
          "reference_uri": { "type": "string", "format": "uri", "minLength": 1 },
          "path_prefix": { "type": "string", "pattern": "^/" },
          "embedded_json": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "representation",
              "script",
              "json_path",
              "record_collection_path",
              "identity_property"
            ],
            "properties": {
              "representation": { "enum": ["embedded_json", "application_state"] },
              "script": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "media_type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "media_type": {
                    "type": "string",
                    "pattern": "^application/(?:json|ld\\+json)(?:\\s*;.*)?$"
                  }
                }
              },
              "json_path": { "type": "string", "minLength": 1 },
              "record_collection_path": { "type": "string", "minLength": 1 },
              "identity_property": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$-]*$" },
              "fact_mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["source_path", "raw_label"],
                  "properties": {
                    "source_path": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                    },
                    "raw_label": { "type": "string", "minLength": 1 },
                    "source_unit": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          },
          "document_link_discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": ["link_attribute", "allowed_extensions", "path_prefix"],
            "properties": {
              "link_attribute": { "const": "href" },
              "allowed_extensions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
              },
              "path_prefix": { "type": "string", "pattern": "^/" },
              "document_urls": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "format": "uri", "minLength": 1 }
              },
              "role_hints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pattern", "role"],
                  "properties": {
                    "pattern": { "type": "string", "minLength": 1 },
                    "role": {
                      "enum": [
                        "product_page",
                        "datasheet",
                        "manual",
                        "installation_manual",
                        "technical_manual",
                        "specification_sheet",
                        "technical_drawing",
                        "dimensional_drawing",
                        "support_article",
                        "certificate",
                        "firmware_document",
                        "unknown"
                      ]
                    }
                  }
                }
              },
              "expected_content": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "value"],
                      "properties": {
                        "kind": { "const": "text_includes" },
                        "value": { "type": "string", "minLength": 1 },
                        "case_sensitive": { "type": "boolean" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "path"],
                      "properties": {
                        "kind": { "const": "json_path_exists" },
                        "path": { "type": "string", "minLength": 1 }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "html_fact_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "path_prefix",
          "identity_selector",
          "identity_kind",
          "regions"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "status": { "enum": ["proposed", "reviewed"] },
          "path_prefix": { "type": "string", "pattern": "^/" },
          "identity_selector": { "$ref": "#/$defs/htmlSelectorChain" },
          "identity_kind": { "enum": ["mpn", "model"] },
          "identity_region": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selector", "heading"],
            "properties": {
              "selector": { "$ref": "#/$defs/htmlSelectorChain" },
              "heading": { "$ref": "#/$defs/htmlHeading" }
            }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selector", "kind"],
              "properties": {
                "selector": { "$ref": "#/$defs/htmlSelectorChain" },
                "kind": {
                  "enum": [
                    "table",
                    "definition",
                    "label_value_lines",
                    "label_value_list",
                    "model_label_value_rows",
                    "explicit_label_value_blocks"
                  ]
                },
                "model_rows": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "row_selector",
                    "cell_selector",
                    "header_selector",
                    "value_identity_attribute",
                    "context_container_selector",
                    "context_heading_selector"
                  ],
                  "properties": {
                    "row_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "cell_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "header_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "context_container_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "context_heading_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "value_identity_attribute": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
                  }
                },
                "explicit_blocks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "row_selector",
                    "label_selector",
                    "value_selector",
                    "value_line_selector",
                    "identity_label",
                    "context_heading_selector"
                  ],
                  "properties": {
                    "row_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "label_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "value_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "value_line_selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "identity_label": { "type": "string", "minLength": 1 },
                    "context_heading_selector": { "$ref": "#/$defs/htmlSelectorChain" }
                  }
                },
                "heading": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["selector", "text"],
                  "properties": {
                    "selector": { "$ref": "#/$defs/htmlSelectorChain" },
                    "text": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "allOf": [
                {
                  "if": { "properties": { "kind": { "const": "model_label_value_rows" } } },
                  "then": { "required": ["model_rows"] },
                  "else": { "not": { "required": ["model_rows"] } }
                },
                {
                  "if": { "properties": { "kind": { "const": "explicit_label_value_blocks" } } },
                  "then": { "required": ["explicit_blocks"] },
                  "else": { "not": { "required": ["explicit_blocks"] } }
                }
              ]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_artifact", "observed_source_content_hash"],
      "properties": {
        "source_artifact": { "type": "string", "minLength": 1 },
        "observed_source_content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "anyOf": [
    { "properties": { "strategies": { "minItems": 1 } } },
    { "required": ["html_fact_rules"], "properties": { "html_fact_rules": { "minItems": 1 } } }
  ],
  "$defs": {
    "htmlHeading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "text"],
      "properties": {
        "selector": { "$ref": "#/$defs/htmlSelectorChain" },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "htmlSelectorChain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "tag": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "id": { "type": "string", "minLength": 1 },
          "class_name": { "type": "string", "pattern": "^\\S+$" },
          "attribute": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "value"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "value": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
