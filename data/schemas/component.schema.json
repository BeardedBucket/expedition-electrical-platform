{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:component",
  "title": "Component",
  "type": "object",
  "required": ["id", "manufacturer", "model", "category", "verification_status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "part_number": {
      "type": ["string", "null"]
    },
    "product_role": {
      "type": ["string", "null"],
      "enum": [
        "battery",
        "inverter_charger",
        "inverter",
        "charger",
        "dc_dc_converter",
        "solar_charge_controller",
        "fuse",
        "breaker",
        "disconnect",
        "busbar",
        "distribution_panel",
        "monitor",
        "gateway",
        "load",
        "other",
        null
      ]
    },
    "category": {
      "type": "string"
    },
    "product_family": {
      "type": ["string", "null"]
    },
    "verification_status": {
      "enum": ["unverified", "partially_verified", "verified"]
    },
    "source_type": {
      "type": ["string", "null"]
    },
    "required_accessories": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "required_converters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "electrical": {
      "type": "object",
      "properties": {
        "nominal_voltage_v": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "input_voltage_range_v": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "output_voltage_range_v": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "continuous_current_a": {
          "type": ["number", "null"]
        },
        "continuous_input_current_a": {
          "type": ["number", "null"]
        },
        "continuous_output_current_a": {
          "type": ["number", "null"]
        },
        "peak_input_current_a": {
          "type": ["number", "null"]
        },
        "peak_output_current_a": {
          "type": ["number", "null"]
        },
        "continuous_charge_current_a": {
          "type": ["number", "null"]
        },
        "continuous_discharge_current_a": {
          "type": ["number", "null"]
        },
        "peak_discharge_current_a": {
          "type": ["number", "null"]
        },
        "continuous_power_w": {
          "type": ["number", "null"]
        },
        "apparent_power_va": {
          "type": ["number", "null"]
        },
        "ac_output_voltage_v": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency_hz": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "battery": {
      "type": ["object", "null"],
      "properties": {
        "nominal_capacity_ah": { "type": ["number", "null"] },
        "usable_capacity_ah": { "type": ["number", "null"] },
        "nominal_energy_wh": { "type": ["number", "null"] },
        "allowed_series_count": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "allowed_parallel_count": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "efficiency_fraction": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "terminals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["function"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "enum": [
              "dc_input",
              "dc_output",
              "ac_input",
              "ac_output",
              "battery",
              "pv_input",
              "chassis_ground",
              "communication",
              "other"
            ]
          },
          "type": { "type": ["string", "null"] },
          "designation": { "type": ["string", "null"] },
          "polarity": {
            "type": ["string", "null"],
            "enum": [
              "positive",
              "negative",
              "neutral",
              "ground",
              "bidirectional",
              "n/a",
              "other",
              null
            ]
          },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "dimensions_mm": {
      "type": ["object", "null"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "weight_kg": {
      "type": ["number", "null"]
    },
    "mounting": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "service_clearances_mm": {
      "type": ["object", "null"],
      "properties": {
        "front": { "type": ["number", "null"] },
        "rear": { "type": ["number", "null"] },
        "left": { "type": ["number", "null"] },
        "right": { "type": ["number", "null"] },
        "top": { "type": ["number", "null"] },
        "bottom": { "type": ["number", "null"] }
      },
      "additionalProperties": true
    },
    "orientation_constraint": {
      "type": ["string", "null"],
      "enum": ["unrestricted", "manufacturer_defined", "unknown", null]
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cad": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "url", "redistribution_status"],
        "properties": {
          "format": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "redistribution_status": {
            "enum": ["unknown", "link_only", "permitted"]
          },
          "license": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "price_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "advisory_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "uri": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "source_type": { "type": ["string", "null"] },
          "summary": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
