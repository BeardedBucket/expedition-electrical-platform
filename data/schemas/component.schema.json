{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:component",
  "title": "Component",
  "type": "object",
  "required": ["id", "manufacturer", "model", "category", "verification_status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "part_number": {
      "type": ["string", "null"]
    },
    "product_role": {
      "type": ["string", "null"],
      "enum": [
        "battery",
        "inverter_charger",
        "inverter",
        "charger",
        "dc_dc_converter",
        "solar_charge_controller",
        "fuse",
        "breaker",
        "disconnect",
        "busbar",
        "distribution_panel",
        "monitor",
        "gateway",
        "load",
        "other",
        null
      ]
    },
    "category": {
      "type": "string"
    },
    "product_family": {
      "type": ["string", "null"]
    },
    "verification_status": {
      "enum": ["unverified", "partially_verified", "verified"]
    },
    "source_type": {
      "type": ["string", "null"]
    },
    "required_accessories": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "required_converters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "electrical": {
      "type": "object",
      "properties": {
        "nominal_voltage_v": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "input_voltage_range_v": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "output_voltage_range_v": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "continuous_current_a": {
          "type": ["number", "null"]
        },
        "continuous_input_current_a": {
          "type": ["number", "null"]
        },
        "continuous_output_current_a": {
          "type": ["number", "null"]
        },
        "peak_input_current_a": {
          "type": ["number", "null"]
        },
        "peak_output_current_a": {
          "type": ["number", "null"]
        },
        "continuous_charge_current_a": {
          "type": ["number", "null"]
        },
        "continuous_discharge_current_a": {
          "type": ["number", "null"]
        },
        "peak_discharge_current_a": {
          "type": ["number", "null"]
        },
        "peak_discharge_duration_s": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "continuous_power_w": {
          "type": ["number", "null"]
        },
        "apparent_power_va": {
          "type": ["number", "null"]
        },
        "ac_output_voltage_v": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency_hz": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "battery": {
      "type": ["object", "null"],
      "properties": {
        "nominal_capacity_ah": { "type": ["number", "null"] },
        "usable_capacity_ah": {
          "type": ["number", "null"],
          "description": "Legacy product-supplied usable Ah; not calculated design-usable energy."
        },
        "nominal_energy_wh": { "type": ["number", "null"] },
        "chemistry": {
          "type": ["string", "null"],
          "enum": ["flooded_lead_acid", "agm", "gel", "lifepo4", "other", null]
        },
        "charge_current": {
          "type": ["object", "null"],
          "properties": {
            "recommended_a": { "type": ["number", "null"], "minimum": 0 },
            "maximum_continuous_a": { "type": ["number", "null"], "minimum": 0 },
            "protection_limit_a": { "type": ["number", "null"], "minimum": 0 }
          },
          "additionalProperties": false
        },
        "allowed_series_count": {
          "description": "Manufacturer-permitted count of identical battery units in series per series string; this is not a total battery count, arbitrary bank size, or parallel-string count.",
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "allowed_parallel_count": {
          "description": "Manufacturer-permitted number of identical series strings connected in parallel; this is not a total battery count, per-string unit count, or arbitrary bank size.",
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "efficiency_fraction": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "terminals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["function"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "function": {
            "enum": [
              "dc_input",
              "dc_output",
              "ac_input",
              "ac_output",
              "battery",
              "pv_input",
              "chassis_ground",
              "communication",
              "other"
            ]
          },
          "type": { "type": ["string", "null"] },
          "designation": { "type": ["string", "null"] },
          "polarity": {
            "type": ["string", "null"],
            "enum": [
              "positive",
              "negative",
              "neutral",
              "ground",
              "bidirectional",
              "n/a",
              "other",
              null
            ]
          },
          "notes": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      },
      "default": []
    },
    "dimensions_mm": {
      "type": ["object", "null"],
      "description": "Physical body dimensions in the component-local frame, in millimeters. x = width, y = depth, z = height. These are not installed/world extents, wall distance, service clearance, or an implied mounting orientation. Installed envelopes are derived from a chosen permitted orientation.",
      "properties": {
        "x": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Component-local width in millimeters."
        },
        "y": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Component-local depth in millimeters."
        },
        "z": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Component-local height in millimeters."
        }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "weight_kg": {
      "type": ["number", "null"]
    },
    "mounting": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "service_clearances_mm": {
      "type": ["object", "null"],
      "description": "Clearances are separate from physical body dimensions. Local face keys x_min/x_max/y_min/y_max/z_min/z_max are component-local; null or missing means unresolved, not zero. Legacy front/rear/left/right/top/bottom keys remain accepted for compatibility but do not define world axes.",
      "properties": {
        "front": { "type": ["number", "null"], "minimum": 0 },
        "rear": { "type": ["number", "null"], "minimum": 0 },
        "left": { "type": ["number", "null"], "minimum": 0 },
        "right": { "type": ["number", "null"], "minimum": 0 },
        "top": { "type": ["number", "null"], "minimum": 0 },
        "bottom": { "type": ["number", "null"], "minimum": 0 },
        "x_min": { "type": ["number", "null"], "minimum": 0 },
        "x_max": { "type": ["number", "null"], "minimum": 0 },
        "y_min": { "type": ["number", "null"], "minimum": 0 },
        "y_max": { "type": ["number", "null"], "minimum": 0 },
        "z_min": { "type": ["number", "null"], "minimum": 0 },
        "z_max": { "type": ["number", "null"], "minimum": 0 }
      },
      "additionalProperties": true
    },
    "orientation_constraint": {
      "description": "Legacy strings remain compatible. The structured form distinguishes unrestricted from unknown and may restrict local mounting faces or stable orientation IDs. Unknown is never permission.",
      "oneOf": [
        {
          "type": ["string", "null"],
          "enum": ["unrestricted", "manufacturer_defined", "unknown", null]
        },
        {
          "type": "object",
          "required": ["status"],
          "properties": {
            "status": { "enum": ["unrestricted", "restricted", "unknown"] },
            "allowedMountingFaces": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["x_min", "x_max", "y_min", "y_max", "z_min", "z_max"] },
              "uniqueItems": true
            },
            "prohibitedMountingFaces": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["x_min", "x_max", "y_min", "y_max", "z_min", "z_max"] },
              "uniqueItems": true
            },
            "allowedOrientationIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "status": { "const": "unrestricted" } } },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["allowedMountingFaces"] },
                    { "required": ["prohibitedMountingFaces"] },
                    { "required": ["allowedOrientationIds"] }
                  ]
                }
              }
            },
            {
              "if": { "properties": { "status": { "const": "unknown" } } },
              "then": {
                "not": {
                  "anyOf": [
                    { "required": ["allowedMountingFaces"] },
                    { "required": ["prohibitedMountingFaces"] },
                    { "required": ["allowedOrientationIds"] }
                  ]
                }
              }
            },
            {
              "if": { "properties": { "status": { "const": "restricted" } } },
              "then": {
                "anyOf": [
                  { "required": ["allowedMountingFaces"] },
                  { "required": ["prohibitedMountingFaces"] },
                  { "required": ["allowedOrientationIds"] }
                ]
              }
            }
          ]
        }
      ]
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cad": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "url", "redistribution_status"],
        "properties": {
          "format": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "redistribution_status": {
            "enum": ["unknown", "link_only", "permitted"]
          },
          "license": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "price_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "advisory_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "uri": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "source_type": { "type": ["string", "null"] },
          "summary": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
