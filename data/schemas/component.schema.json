{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:expedition-electrical-platform:schema:component",
  "title": "Component",
  "type": "object",
  "required": ["id", "manufacturer", "model", "category", "verification_status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "manufacturer": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "part_number": {
      "type": ["string", "null"]
    },
    "category": {
      "type": "string"
    },
    "verification_status": {
      "enum": ["unverified", "partially_verified", "verified"]
    },
    "source_type": {
      "type": ["string", "null"]
    },
    "required_accessories": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "required_converters": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "label": { "type": ["string", "null"] },
              "note": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        ]
      },
      "default": []
    },
    "electrical": {
      "type": "object",
      "properties": {
        "nominal_voltage_v": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "input_voltage_range_v": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "output_voltage_range_v": {
          "type": ["object", "null"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          },
          "required": ["min", "max"],
          "additionalProperties": false
        },
        "continuous_current_a": {
          "type": ["number", "null"]
        },
        "continuous_power_w": {
          "type": ["number", "null"]
        },
        "apparent_power_va": {
          "type": ["number", "null"]
        },
        "ac_output_voltage_v": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frequency_hz": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "advisory_state": {
      "type": ["object", "null"],
      "properties": {
        "status": {
          "enum": ["none", "info", "watch", "advisory", "critical"]
        },
        "recommendation_effect": {
          "enum": ["none", "warn", "suppress_default", "exclude"]
        },
        "summary": {
          "type": ["string", "null"]
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "dimensions_mm": {
      "type": ["object", "null"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      },
      "required": ["x", "y", "z"],
      "additionalProperties": false
    },
    "weight_kg": {
      "type": ["number", "null"]
    },
    "mounting": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "clearances_mm": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "cad": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["format", "url", "redistribution_status"],
        "properties": {
          "format": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "redistribution_status": {
            "enum": ["unknown", "link_only", "permitted"]
          },
          "license": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "price_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "advisory_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "type": { "type": ["string", "null"] },
          "uri": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "source_type": { "type": ["string", "null"] },
          "summary": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
