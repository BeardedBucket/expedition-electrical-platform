{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering Rule",
  "type": "object",
  "required": ["id", "version", "status", "kind", "description", "source_refs"],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "string"},
    "status": {"enum": ["draft", "reviewed", "approved", "deprecated"]},
    "kind": {"enum": ["calculation", "constraint", "warning", "recommendation", "scoring"]},
    "description": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "expression": {"type": ["string", "null"]},
    "conditions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "outputs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "tests": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
  },
  "additionalProperties": true
}
